/asm
/gfx
/prg
/html
/map
*.class
*.o
*.lst
*.lst.json
/tmp/
__pycache__/
.env
projects/*/docs/reverse_engineering/inventory/pass/

# Large auto-regenerated intake artifacts (rewritten by `make project-intake`)
projects/*/docs/reverse_engineering/inventory/intake_listing.json
projects/*/docs/reverse_engineering/inventory/intake_xref.json
projects/*/docs/reverse_engineering/inventory/raw_address_audit.json

# Regenerate-on-demand policy-baseline pending-queue snapshots: embed absolute
# source line numbers, so any earlier edit invalidates most rows and produces
# a full-file diff with no durable content. Regenerate locally; do not track.
projects/*/scripts/policy_baseline_remaining.txt

# Project-specific binaries and build artifacts
projects/*/reference/*
projects/*/build/
projects/*/tmp/
# Trace-helper mods are local, untracked unless explicitly curated (git add -f).
projects/*/mods/

# Exclude all third-party/external reference material. Authored terminology
# extraction and crosswalk analysis belong in tracked docs/crosswalk/.
projects/*/docs/game_reference/

# Local agent-review handoff runtime state. Tracked role docs may be added under
# .agents/ later; only mutable state is ignored here.
.agents/current.json
.agents/runs/
.agents/logs/
.agents/reference_intake/
.agents/permissions/
.codex/rules/nesrev-pass-cycle.rules
